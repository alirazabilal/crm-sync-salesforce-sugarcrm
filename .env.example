# Copy this file to .env and fill in your values. Never commit .env.

# Salesforce External Client App (client credentials flow)
SF_LOGIN_URL=https://your-org.develop.my.salesforce.com
SF_CLIENT_ID=your_consumer_key
SF_CLIENT_SECRET=your_consumer_secret

# Local SuiteCRM (SugarCRM side). Pick any passwords; Docker uses them on first start.
SUGAR_URL=http://localhost:8081
SUGAR_USERNAME=admin
SUGAR_PASSWORD=change_me
SUITE_DB_PASSWORD=change_me_too
SUITE_DB_ROOT_PASSWORD=change_me_three

# MongoDB
MONGO_URL=mongodb://localhost:27017/crm_sync

# Sync hub
PORT=3000
SYNC_CRON=*/5 * * * *
